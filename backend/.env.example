APP_NAME=HARIKA-Core
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cognition Engine Settings
DEFAULT_LLM_PROVIDER=ollama
