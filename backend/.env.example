# Vision Engine Settings
VISION_PROVIDER=local
VISION_MODEL=local-vision-v1

# Voice Engine 2.0 Settings
TTS_PROVIDER=browser
TTS_MODEL=default
STT_PROVIDER=browser
STT_MODEL=default
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


