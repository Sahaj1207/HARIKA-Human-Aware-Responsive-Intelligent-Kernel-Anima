{
  "manifest_version": 3,
  "name": "HARIKA",
  "version": "1.0.0",
  "description": "Lets HARIKA, your assistant on this computer, do website tasks in a tab of this browser while you watch.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "HARIKA" },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" }
}
