{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HARIKA",
  "version": "0.1.0",
  "identifier": "com.harika.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HARIKA",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/build/dist/harika-backend/": "backend/"
    },
    "publisher": "HARIKA",
    "shortDescription": "HARIKA, your personal assistant",
    "longDescription": "HARIKA is a personal assistant for your computer: it opens apps, finds files, sets reminders, controls your system and answers questions, privately on your computer or with the AI service you choose.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
